{
  "name": "weather-forecast-card",
  "version": "1.2.0-devel",
  "description": "A TypeScript weather forecast card built with Parcel",
  "browserslist": "ios >= 15, safari >= 15, last 2 versions, not dead",
  "author": "troinine",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "keywords": [
    "home-assistant",
    "weather-forecast",
    "weather-card",
    "weather-forecast-card",
    "home-assistant-frontend",
    "custom-card"
  ],
  "type": "module",
  "module": "dist/weather-forecast-card.js",
  "targets": {
    "module": {
      "distDir": "./dist",
      "source": [
        "src/index.ts"
      ],
      "optimize": true,
      "publicUrl": "/hacsfiles/ha-weather-forecast-card/",
      "includeNodeModules": true
    }
  },
  "scripts": {
    "dev": "parcel serve test/app/index.html test/app/resources/img/*.svg --open",
    "build": "parcel build --no-source-maps --target module",
    "build:debug": "parcel build --target module --no-optimize",
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const path of ['dist', '.parcel-cache']) rmSync(path, { recursive: true, force: true })\"",
    "demo": "parcel serve demo/index.html demo/background.png",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "consola": "3.4.2",
    "custom-card-helpers": "1.9.0",
    "home-assistant-js-websocket": "9.6.0",
    "lit": "3.3.3",
    "lodash-es": "4.18.1",
    "memoize-one": "6.0.0",
    "suncalc": "1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/js": "7.4.47",
    "@open-wc/testing": "4.0.0",
    "@parcel/transformer-inline-string": "2.16.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.13.2",
    "@types/suncalc": "1.9.2",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.10.6",
    "parcel": "2.16.4",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "vitest": "4.1.9"
  }
}
